{
  "name": "dsh-turn-cleanup",
  "version": "0.2.0",
  "description": "turn 结束时检查本轮 agent 留下的临时文件（.agent-tmp/ 约定目录 + 本 turn 写入追踪）与超量备份（同一原件的 .bak 只留最近 N 份），非空则 steer 模型再走一步清场。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cleanup",
    "turn-stopping",
    "agent-hygiene"
  ],
  "license": "MIT",
  "author": "Leonlee114514",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leonlee114514/dsh-turn-cleanup.git"
  },
  "bugs": {
    "url": "https://github.com/Leonlee114514/dsh-turn-cleanup/issues"
  },
  "homepage": "https://github.com/Leonlee114514/dsh-turn-cleanup#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.5"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check test/sim.mjs",
    "test": "node test/sim.mjs",
    "verify": "npm run check && npm test"
  }
}
